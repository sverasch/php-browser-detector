{
  "manifest_version": 3,
  "name": "PHP Detector",
  "version": "0.1.0",
  "description": "Detect PHP backends in browsers for security research",
  "icons": {
    "16": "icons/php-16.png",
    "32": "icons/php-32.png",
    "48": "icons/php-48.png",
    "128": "icons/php-128.png"
  },
  "permissions": [],
  "host_permissions": [],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-scripts/detector.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/php-16.png",
      "32": "icons/php-32.png",
      "48": "icons/php-48.png",
      "128": "icons/php-128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/php-16.png"],
      "matches": ["<all_urls>"]
    }
  ]
}
